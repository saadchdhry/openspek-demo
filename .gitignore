node_modules/
.DS_Store

# Personal editor state; workspace.json churns on every pane move.
.obsidian/

# .claude/ IS committed on purpose. The opsx commands and openspec-*
# skills are generated by `openspec init --tools claude` and pinned to
# a version (generatedBy: 1.7.0). DEMO.md is verified against that
# version, so committing them keeps the demo reproducible instead of
# dependent on whatever openspec is on the presenter's PATH.
# Machine-local overrides still stay out:
.claude/settings.local.json
